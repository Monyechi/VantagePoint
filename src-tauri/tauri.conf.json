{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VantagePoint",
  "version": "0.1.0",
  "identifier": "com.clientpilot.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VantagePoint",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost blob: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:clientpilot.db"]
    },
    "updater": {
      "endpoints": [
        "https://github.com/Monyechi/ClientPilot/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNEMzVGNDMyNjdDMzdFODgKUldTSWZzTm5NdlExUGNaRytRYnp3NFJBQitVOGkyWG50blRxbGp1VE44L2RVU2JsYTdmT3kxdTAK"
    }
  }
}
